# Generated arm caches. Rebuilt in ~1 minute by
# code/scripts/00_prepare_data.py, and they are derived from data we cannot
# redistribute anyway.
data/processed/

# Third-party raw data that is not ours to redistribute:
# choices13k is CC BY-NC-SA, the CPC18 full raw release is a separate download.
# See data/external/ATTRIBUTION.md for where to get each.
data/choices13k*/
data/cpc18_raw/
data/2571510/
data/321652/
data/845873/
*.zip

# Per-run training artefacts: 2,240 directories of .npz, ~32 MB, fully
# reproducible from code/scripts/01_run_grid.py. Everything downstream reads
# the aggregated tables instead, so nothing here needs to be shared.
results/runs/

# Working copies of the figures. The versions that matter are committed under
# paper_results/, which 10_main_figures.py assembles.
results/figures/

# Per-run record tables (theory_coords.csv, indices.csv, sr_expressions.csv,
# probe_level_omega2.csv, runs_*.csv) ARE committed, ~3.5 MB in total: they are
# one row per trained model, and shipping them means the whole analysis from
# stage 06 onward can be re-run and checked without retraining 2,240 models.
# They contain no third-party data rows -- only fitted coefficients, metrics and
# the project's own synthetic probe grid.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
